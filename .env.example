# =====================================================================
#  EFORT Web Monitoring - 环境变量模板
#  用法: 复制本文件为 .env (放在项目根目录), 按需改值。
#        后端启动时自动读取 .env; 已存在的系统环境变量优先, 不会被覆盖。
#        不建 .env 也能跑 —— 所有项都有内置默认值。
# =====================================================================

# ---- 后端 ----

# 模拟模式: auto = 连不上机器人自动回退模拟轨迹(默认)
#           always = 强制模拟(无机器人也能演示)
#           never  = 强制真机, 连不上就报错
EFORT_SIMULATE=auto

# 覆盖数据库位置(SQLAlchemy URL)。留空则用 config/robot.yaml 的 data/robot.db
# 例: EFORT_DB_URL=sqlite:///D:/EFORT_Projects/EFORT_Web_Monitoring/data/robot.db
# EFORT_DB_URL=

# ---- 控制权限（阶段 1，必设！）----
# 管理员密码：连接真机执行 / 急停前需此密码换取限时控制令牌(X-Control-Token)。
# 未设置时每次启动生成随机临时密码并打印到日志（无人可用，仅防误开控制门）。
EFORT_ADMIN_PASSWORD=change-me-to-a-strong-password

# 操作员密码（阶段 4 角色，选填）
# 只能操控机器人(下发/急停)，改不了安全围栏配置、导不了备份、清不了审计日志。
# 留空 = 不启用操作员角色，所有令牌都是管理员权限（与阶段 1 行为一致）。
# EFORT_OPERATOR_PASSWORD=

# 围栏互锁严格模式对应的开关在 config/robot.yaml: motion.require_live_safety
# true  = 前端没实时上报围栏状态(或状态已过期)时，服务端拒绝下发运动
# false = 放行但记一条 "control.interlock_absent" 告警事件（默认，兼容纯脚本调用）

# 控制令牌有效期（秒）。0 = 不限时（直到后端重启 / 主动登出）。
# ★ 现场口径 **7200 = 2 小时**（2026-09-29 用户确认）。曾长期为 1800，
#   导致"设置页改成 2 小时、一重启又回到 30 分钟"——因为启动只读这一行。
#   ★ 本文件是**启动默认值**：设置页的改动会自动回写 .env 的同一行；
#     两者不一致时以 .env 为准（启动时读它）。
EFORT_CONTROL_TTL=7200

# ---- 执行引擎真实下发（阶段 2，默认关闭！）----
# 真实下发给控制器需双确认，否则只做校验 + 记录(模拟)，避免误动作：
#   1) 本变量 = 1   2) config/robot.yaml 的 motion.real_write = true
# 写寄存器地址务必按控制器手册核对后再开启。
# EFORT_REAL_MOTION=0

# ---- 视觉检测服务 (camera/camera_service.py, 端口 8100) ----

# ★★ 相机后端：usb(默认) | mvs | auto
#   usb  = **不启用海康工业相机**：不加载 MVS SDK、不枚举、不塞 PATH（现场用 USB 摄像头就选它）
#   auto = 有海康网口相机就优先用，没有就退 USB（老行为）
#   mvs  = 只用海康工业相机
EFORT_CAMERA_KIND=usb

# 服务端口
CAMERA_PORT=8100

# ★★ 2026-10-10 安全加固：视觉服务**本身没有任何鉴权**，默认只允许**本机**访问。
#   需要从别的电脑看画面时改成 EFORT_CAMERA_HOST=0.0.0.0，
#   并**强烈建议同时设 EFORT_CAMERA_TOKEN**（否则等于把"开/关相机、改判色阈值"摊给局域网）。
EFORT_CAMERA_HOST=127.0.0.1
# 相机服务共享令牌（选填）。设了 → 写接口必须带 X-Camera-Token；
# 页面侧的 fetch 会自动带上（见 frontend 的 VITE_CAMERA_TOKEN，需与这里一致）。
# EFORT_CAMERA_TOKEN=change-me-camera-token
# MJPEG 并发上限（默认 6）。原来无上限，几十个 /stream 就能把线程/带宽吃光。
EFORT_CAMERA_MAX_STREAM=6

# ---- 后端监听地址 ----
# ★★ 2026-10-10：默认只绑本机。要从别的电脑访问，改 EFORT_HOST=0.0.0.0
#   （登录口与全部 API 会暴露到局域网；已有令牌鉴权+登录限流，但没必要就别开）。
# EFORT_HOST=127.0.0.1
# 同步端点线程池上限（默认 96）。长任务（程序执行 / 一键就绪 / AI 对话）会占住 worker，
# 池太小会导致"整个网页转圈点不动"。改小请谨慎。
# EFORT_THREAD_POOL=96

# MVS 相机 SDK 的 Python 封装目录 (内含 MvCameraControl_class.py)
# 留空则用内置默认: D:\EFORT_Projects\EFORT_Camera_Python_OpenCv\src\sdk\MvImport
# EFORT_MVS_SDK_DIR=D:\EFORT_Projects\EFORT_Camera_Python_OpenCv\src\sdk\MvImport

# MVS 运行时 DLL 目录 (海康 MVS 客户端安装自带)
# 留空则用内置默认: C:\Program Files (x86)\Common Files\MVS\Runtime\Win64_x64
# EFORT_MVS_RUNTIME_DIR=C:\Program Files (x86)\Common Files\MVS\Runtime\Win64_x64

# 跑视觉服务的 Python 解释器 (需含 torch / ultralytics / MVS 封装)
# 留空则用内置默认: D:\EFORT_Projects\EFORT_Camera_Python_OpenCv\venv\Scripts\python.exe
# EFORT_CAMERA_PYTHON=D:\EFORT_Projects\EFORT_Camera_Python_OpenCv\venv\Scripts\python.exe

# ---------- 实时语音字幕（腾讯云实时语音识别 ASR）----------
# 用途：说话实时转文字，像电影字幕一样叠在 3D 画面底部（见 docs/方案-实时语音字幕（腾讯云ASR）.md）
# ★ 密钥只放本文件（后端读取），**绝不下发浏览器**；.env 不被 git 跟踪，勿提交。
# ★ 留 EFORT_ASR_PROVIDER 为空 = 整条功能关闭（界面会如实提示"未启用"）。
# 腾讯云控制台 → 访问管理 → API 密钥管理 取 SecretId/SecretKey；
# AppID 在账号信息里（实时语音识别控制台也有）。实时语音识别需在控制台开通。
EFORT_ASR_PROVIDER=tencent
EFORT_ASR_APPID=your-appid
EFORT_ASR_SECRET_ID=your-secret-id
EFORT_ASR_SECRET_KEY=your-secret-key
EFORT_ASR_ENGINE=16k_zh
# 单次识别时长上限（秒），默认 600（10 分钟）：防止"开着忘关"把云端额度烧掉
EFORT_ASR_MAX_SEC=600

# ---------- 视觉检测阈值（YOLO）----------
# 检测置信度：低于此值的目标不画框、不记录。★ 调高 = 误报更少但可能漏检。
# 原默认 0.25（YOLO 出厂值）误报偏多，2026-10-08 提到 0.5；
# 也可以在摄像头面板的「检测置信度」滑杆上实时调（立即生效，但重启会回到本值）。
EFORT_CAM_CONF=0.5
# 三色识别置信度（颜色分拣用，与上面的目标检测是两套判据）
EFORT_CAM_COLOR_CONF=0.28
